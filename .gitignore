# Downloaded market data stays local; small reference lists may be tracked.
# Required frozen release files are explicitly tracked; new downloads stay local.
/data/*
!/data/reference/

# Experiment runs, official raw responses, ledgers and scratch work stay local.
# Never `git add -f` anything under outputs/: summaries belong in reports/.
# Full pre-cleanup evidence (V1–V4 runs, ledgers, raw caches) is kept at
# commit 2769f876. Legacy code (V2–V5) lives under legacy/ and writes to
# legacy/outputs/. Still tracked there: the fixed v2 config that
# legacy/src/strategy_24d.py loads, and each V3 round's candidates.json +
# development_ranking.csv that the round-3/4/expansion tests rebuild
# candidate lineage from. Tracked files stay tracked despite these rules.
/outputs/
/legacy/outputs/
/tmp/
/legacy/tmp/
nohup.out

# Claude Code per-machine settings
.claude/settings.local.json

# Daily account state, runtime journals, generated orders and raw responses
/daily_auto/inbox/
/daily_auto/private/
/daily_auto/runtime/
/daily_auto/runs/
/daily_auto/evidence/raw/
