# Downloaded market data stays local; small reference lists may be tracked.
# Frozen datasets needed for reproduction must be selected explicitly later.
/data/*
!/data/reference/

# Large experiment runs, repeated input snapshots and scratch work
# Keep source, config, tests, docs, research, official_docs and reports eligible.
/outputs/
/tmp/

