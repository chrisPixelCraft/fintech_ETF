      "name": "rank",
      "module": "src.v5_rank",
      "simplicity": 2
    },
    "B": {
      "name": "ensemble",
      "module": "src.v5_ensemble",
      "simplicity": 3
    }
  },
  "axes": {
    "A": [
      "blend",
      "trend_filter",
      "n",
      "rotation"
    ],
    "B": [
      "horizon",
      "window",
      "score",
      "n",
