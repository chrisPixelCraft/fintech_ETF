  "construction_default": {
    "method": "topn_equal",
    "cash_target": 0.05,
    "min_names": 20,
    "max_names": 30,
    "max_weight": 0.1,
    "tsmc_max_weight": 0.25,
    "regime": false
  },
  "regime_overlay": {
    "breadth_threshold": 0.4,
    "vol_pct_threshold": 0.7,
    "vol_window": 20,
    "pct_window": 250,
    "min_history": 60,
    "rule": "risk_off = D-1 breadth(price_ema20>0 share) < 0.40 AND D-1 market-vol percentile >= 0.70; risk_off -> cash 10% and zero voluntary replacements"
  },
  "risk_aware": {
    "risk_lambda": 1.0,
    "variance_horizon": 20,
    "min_weight": 0.005,
    "objective": "mu.w - lambda * sum(vol20^2 * variance_horizon * w^2); mu = expected_return if present else 0.1*(rank_pct-0.5)"
  },
  "s2_treatments": [
    {
      "id": "T1",
      "method": "topn_equal",
      "regime": true
    },
    {
      "id": "T2",
      "method": "score_bounded",
      "regime": false
    },
    {
      "id": "T3",
      "method": "score_bounded",
      "regime": true
    },
    {
      "id": "T4",
      "method": "risk_aware",
      "regime": false
    },
    {
      "id": "T5",
      "method": "risk_aware",
      "regime": true
    }
  ],
  "s2_keep_rule": {
    "median_delta_min": 0.0,
    "p25_delta_min": -0.005,
    "paired": "both-complete development episodes"
  },
